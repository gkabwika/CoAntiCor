@page "/executive-dashboard"
@using CoAntiCor.App.Resources
@using CoAntiCor.Core.DTO.Incident
@using CoAntiCor.Core.Domain.ServiceRequest
@using CoAntiCor.Core.Model
@using CoAntiCor.Infrastructure.Context
@using Microsoft.AspNetCore.Mvc
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L
@inject HttpClient Http

@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> Localizer
@inject IDbContextFactory<CoAntiCorDbContext> _db

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="row mb-3">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold">@Localizer["Exec_Title"]</h2>
                <p class="text-muted mb-0">@Localizer["Exec_Subtitle"]</p>
            </div>
            <div class="d-flex gap-2">
                <select class="form-select form-select-sm" style="width: 180px" @bind="SelectedPeriod">
                    <option value="Last30Days">@Localizer["Exec_Period_Last30Days"]</option>
                    <option value="LastQuarter">@Localizer["Exec_Period_LastQuarter"]</option>
                    <option value="YearToDate">@Localizer["Exec_Period_YTD"]</option>
                </select>
                <select class="form-select form-select-sm" style="width: 180px" @bind="SelectedProvince">
                    <option value="">@Localizer["Exec_AllProvinces"]</option>
                    @foreach (var p in Provinces)
                    {
                        <option value="@p">@p</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <!-- Top KPI row -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted">@Localizer["Exec_KPI_TotalIncidents"]</span>
                        <span class="badge bg-primary">@Localizer["Exec_KPI_Today"]</span>
                    </div>
                    <h3 class="fw-bold">@TotalIncidents.ToString("N0")</h3>
                    <small class="@GetTrendClass(IncidentTrend)">
                        @Localizer["Exec_KPI_Trend"]: @IncidentTrend.ToString("+#,##0;-#,##0;0") %
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <span class="text-muted">@Localizer["Exec_KPI_AmountSaved"]</span>
                    <h3 class="fw-bold">@AmountSaved.ToString("N0") $</h3>
                    <small class="text-success">@Localizer["Exec_KPI_AmountSaved_Label"]</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <span class="text-muted">@Localizer["Exec_KPI_AvgProcessingTime"]</span>
                    <h3 class="fw-bold">@AverageProcessingDays.ToString("N1") @Localizer["Exec_Days"]</h3>
                    <small class="text-muted">@Localizer["Exec_KPI_AvgProcessingTime_Label"]</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <span class="text-muted">@Localizer["Exec_KPI_Profitability"]</span>
                    <h3 class="fw-bold">@ProfitabilityRatio.ToString("P1")</h3>
                    <small class="text-muted">@Localizer["Exec_KPI_Profitability_Label"]</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Middle row: Forecasting + Province ranking -->
    <div class="row g-3 mb-4">
        <!-- Forecasting (Prévisions IA) -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@Localizer["Exec_Forecasting_Title"]</h5>
                    <span class="badge bg-info">@Localizer["Exec_Forecasting_IA"]</span>
                </div>
                <div class="card-body">
                    <!-- Placeholder for chart -->
                    <div class="bg-light rounded-3 p-3" style="height: 260px;">
                        <p class="text-muted">@Localizer["Exec_Forecasting_ChartPlaceholder"]</p>
                        <!-- Integrate chart library later (e.g., Chart.js, ApexCharts) -->
                    </div>
                    <div class="mt-3 d-flex flex-wrap gap-3">
                        <div>
                            <span class="text-muted">@Localizer["Exec_Forecasting_Next30Days"]</span>
                            <h6 class="fw-bold">@ForecastNext30Days.ToString("N0")</h6>
                        </div>
                        <div>
                            <span class="text-muted">@Localizer["Exec_Forecasting_RiskScore"]</span>
                            <h6 class="fw-bold">@RiskScore.ToString("N1") / 10</h6>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Province ranking -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@Localizer["Exec_ProvinceRanking_Title"]</h5>
                    <span class="badge bg-secondary">@Localizer["Exec_ProvinceRanking_Label"]</span>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        @foreach (var item in ProvinceRanking)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>@item.Province</span>
                                <span class="fw-bold">@item.IncidentCount.ToString("N0")</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom row: Profitability dashboard + category breakdown -->
    <div class="row g-3">
        <!-- Profitability (coûts vs revenus) -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@Localizer["Exec_Profitability_Title"]</h5>
                    <span class="badge bg-success">@Localizer["Exec_Profitability_Label"]</span>
                </div>
                <div class="card-body">
                    <div class="bg-light rounded-3 p-3 mb-3" style="height: 220px;">
                        <p class="text-muted">@Localizer["Exec_Profitability_ChartPlaceholder"]</p>
                    </div>
                    <div class="row text-center">
                        <div class="col-4">
                            <small class="text-muted">@Localizer["Exec_Profitability_Costs"]</small>
                            <div class="fw-bold">@TotalCosts.ToString("N0") $</div>
                        </div>
                        <div class="col-4">
                            <small class="text-muted">@Localizer["Exec_Profitability_Revenues"]</small>
                            <div class="fw-bold">@TotalRevenues.ToString("N0") $</div>
                        </div>
                        <div class="col-4">
                            <small class="text-muted">@Localizer["Exec_Profitability_Net"]</small>
                            <div class="fw-bold">@NetProfit.ToString("N0") $</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Category breakdown -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@Localizer["Exec_CategoryBreakdown_Title"]</h5>
                    <span class="badge bg-warning text-dark">@Localizer["Exec_CategoryBreakdown_Label"]</span>
                </div>
                <div class="card-body">
                    <div class="bg-light rounded-3 p-3 mb-3" style="height: 220px;">
                        <p class="text-muted">@Localizer["Exec_CategoryBreakdown_ChartPlaceholder"]</p>
                    </div>
                    <ul class="list-group list-group-flush">
                        @foreach (var cat in CategoryBreakdown)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>@cat.CategoryName</span>
                                <span class="fw-bold">@cat.IncidentCount.ToString("N0")</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>



<div>

    <p>Forecasting Chart (Prévisions IA)</p>

    <ApexChart TItem="ForecastPoint" Title="@Localizer["Exec_Forecasting_Title"]">
    <ApexSeries TItem="ForecastPoint"
                Items="ForecastData"
                Name="@Localizer["Exec_Forecasting_Series"]"
                XValue="GetForecastDate"
                YValue="GetForecastValue" />
</ApexChart>

@code {
    public class ForecastPoint
    {
        public DateTime Date { get; set; }
        public int Value { get; set; }
    }

    private List<ForecastPoint> ForecastData = new()
    {
        new() { Date = DateTime.Today.AddDays(-5), Value = 120 },
        new() { Date = DateTime.Today.AddDays(-4), Value = 140 },
        new() { Date = DateTime.Today.AddDays(-3), Value = 160 },
        new() { Date = DateTime.Today.AddDays(-2), Value = 180 },
        new() { Date = DateTime.Today.AddDays(-1), Value = 210 },
    };

    private object GetForecastDate(ForecastPoint point) => point.Date;
    private object GetForecastValue(ForecastPoint point) => point.Value;
}

</div>


<div>

    <p>Profitability Chart (Coûts vs Revenus)</p>

<ApexChart TItem="ProfitPoint" Title="@Localizer["Exec_Profitability_Title"]">
    <ApexSeries TItem="ProfitPoint"
                Items="ProfitData"
                Name="@Localizer["Exec_Profitability_Costs"]"
                XValue="GetLabel"
                YValue="GetCost" />

    <ApexSeries TItem="ProfitPoint"
                Items="ProfitData"
                Name="@Localizer["Exec_Profitability_Revenues"]"
                XValue="GetLabel"
                YValue="GetRevenue" />
</ApexChart>

@code {



    private object GetLabel(ProfitPoint point) => point.Label;
        private decimal GetCost(ProfitPoint point) => (decimal)point.Cost;
        private decimal GetRevenue(ProfitPoint point) => (decimal)point.Revenue;

    public class ProfitPoint
    {
        public string Label { get; set; } = default!;
        public double Cost { get; set; }
        public double Revenue { get; set; }
    }

    private List<ProfitPoint> ProfitData = new()
    {
        new() { Label = "Jan", Cost = 120000, Revenue = 350000 },
        new() { Label = "Feb", Cost = 140000, Revenue = 420000 },
        new() { Label = "Mar", Cost = 160000, Revenue = 480000 },
    };
}

</div>



@code {
    // [Inject]
    // private CoAntiCorDbContext _db { get; set; } = default!;
    private string SelectedPeriod { get; set; } = "Last30Days";
    private string? SelectedProvince { get; set; }

    private List<string> Provinces { get; } = new()
    {
        "Kinshasa", "Kongo Central", "Nord-Kivu", "Sud-Kivu", "Haut-Katanga"
        // etc.
    };

    // Mock data for now – later bind to API
    private int TotalIncidents { get; set; } = 1245;
    private double IncidentTrend { get; set; } = 8.3;
    private double AmountSaved { get; set; } = 3_500_000;
    private double AverageProcessingDays { get; set; } = 12.4;
    private double ProfitabilityRatio { get; set; } = 0.72;

    private double ForecastNext30Days { get; set; } = 210;
    private double RiskScore { get; set; } = 6.7;

    private double TotalCosts { get; set; } = 850_000;
    private double TotalRevenues { get; set; } = 4_350_000;
    private double NetProfit => TotalRevenues - TotalCosts;

    private List<(string Province, int IncidentCount)> ProvinceRanking { get; set; }
        = new()
        {
            ("Kinshasa", 420),
            ("Nord-Kivu", 210),
            ("Haut-Katanga", 180),
            ("Kongo Central", 150),
            ("Sud-Kivu", 120)
        };

    private List<(string CategoryName, int IncidentCount)> CategoryBreakdown { get; set; }
        = new()
        {
            ("Corruption", 380),
            ("Fraude financière", 260),
            ("Conflit d'intérêts", 190),
            ("Blanchiment d'argent", 140),
            ("Cybercriminalité", 80)
        };

    private string GetTrendClass(double trend)
        => trend >= 0 ? "text-success" : "text-danger";


    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        var url = $"api/servicerequests/searchadavance?province={SelectedProvince}&period={SelectedPeriod}&page=1&pageSize=50";

       // var result = await Http.GetFromJsonAsync<PagedResult<ServiceRequestDto>>(url);

        PagedResult<ServiceRequestDto> result = await SearchAdvanceLocal("", "", "", 1, 20);

        if (result != null)
        {
            TotalIncidents = result.TotalCount;
            ProvinceRanking = result.Items
                .GroupBy(x => x.Province)
                .Select(g => (Province: g.Key, IncidentCount: g.Count()))
                .OrderByDescending(x => x.IncidentCount)
                .ToList();

            CategoryBreakdown = result.Items
                .GroupBy(x => x.Category)
                .Select(g => (CategoryName: g.Key, IncidentCount: g.Count()))
                .OrderByDescending(x => x.IncidentCount)
                .ToList();
        }
    }

    public async Task<PagedResult<ServiceRequestDto>> SearchAdvanceLocal(
                    string? province,
                    string? category,
                    string? period,
                    int page = 1,
                    int pageSize = 20)
    {
        // FIX: Use a context instance from the factory
        await using var db = await _db.CreateDbContextAsync();

        var query = db.IncidentRequests.AsQueryable();

        if (!string.IsNullOrWhiteSpace(province))
            query = query.Where(x => x.Province == province);

        if (!string.IsNullOrWhiteSpace(category))
            query = query.Where(x => x.Category == category);

        if (!string.IsNullOrWhiteSpace(period))
            query = ApplyPeriodFilter(query, period);

        var total = await query.CountAsync();

        var items = await query
               .OrderByDescending(x => x.CreatedAt)
               .Skip((page - 1) * pageSize)
               .Take(pageSize)
               .Select(x => new ServiceRequestDto
               {
                   Id = x.Id,
                   IncidentNumber = x.IncidentNumber,
                   Province = x.Province,
                   Category = x.Category,
                   IncidentType = x.IncidentType != null ? x.IncidentType.Name : string.Empty,
                   Status = x.Status,
                   CreatedAt = x.CreatedAt
               })
               .ToListAsync();

        return new PagedResult<ServiceRequestDto>(items, total, page, pageSize);
    }

    private IQueryable<IncidentRequest> ApplyPeriodFilter(IQueryable<IncidentRequest> query, string period)
    {
        // Example: filter by year or month, adjust as needed
        if (string.IsNullOrWhiteSpace(period))
            return query;

        if (period.Equals("last30days", StringComparison.OrdinalIgnoreCase))
        {
            var fromDate = DateTime.UtcNow.AddDays(-30);
            return query.Where(x => x.CreatedAt >= fromDate);
        }
        if (period.Equals("thisyear", StringComparison.OrdinalIgnoreCase))
        {
            var year = DateTime.UtcNow.Year;
            return query.Where(x => x.CreatedAt.Year == year);
        }
        // Add more period filters as needed

        return query;
    }
}
