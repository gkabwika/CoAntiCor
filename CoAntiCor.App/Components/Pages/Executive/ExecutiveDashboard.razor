@page "/executive-dashboard"
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="row mb-3">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold">@L["Exec_Title"]</h2>
                <p class="text-muted mb-0">@L["Exec_Subtitle"]</p>
            </div>
            <div class="d-flex gap-2">
                <select class="form-select form-select-sm" style="width: 180px" @bind="SelectedPeriod">
                    <option value="Last30Days">@L["Exec_Period_Last30Days"]</option>
                    <option value="LastQuarter">@L["Exec_Period_LastQuarter"]</option>
                    <option value="YearToDate">@L["Exec_Period_YTD"]</option>
                </select>
                <select class="form-select form-select-sm" style="width: 180px" @bind="SelectedProvince">
                    <option value="">@L["Exec_AllProvinces"]</option>
                    @foreach (var p in Provinces)
                    {
                        <option value="@p">@p</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <!-- Top KPI row -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted">@L["Exec_KPI_TotalIncidents"]</span>
                        <span class="badge bg-primary">@L["Exec_KPI_Today"]</span>
                    </div>
                    <h3 class="fw-bold">@TotalIncidents.ToString("N0")</h3>
                    <small class="@GetTrendClass(IncidentTrend)">
                        @L["Exec_KPI_Trend"]: @IncidentTrend.ToString("+#,##0;-#,##0;0") %
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <span class="text-muted">@L["Exec_KPI_AmountSaved"]</span>
                    <h3 class="fw-bold">@AmountSaved.ToString("N0") $</h3>
                    <small class="text-success">@L["Exec_KPI_AmountSaved_Label"]</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <span class="text-muted">@L["Exec_KPI_AvgProcessingTime"]</span>
                    <h3 class="fw-bold">@AverageProcessingDays.ToString("N1") @L["Exec_Days"]</h3>
                    <small class="text-muted">@L["Exec_KPI_AvgProcessingTime_Label"]</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <span class="text-muted">@L["Exec_KPI_Profitability"]</span>
                    <h3 class="fw-bold">@ProfitabilityRatio.ToString("P1")</h3>
                    <small class="text-muted">@L["Exec_KPI_Profitability_Label"]</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Middle row: Forecasting + Province ranking -->
    <div class="row g-3 mb-4">
        <!-- Forecasting (Prévisions IA) -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@L["Exec_Forecasting_Title"]</h5>
                    <span class="badge bg-info">@L["Exec_Forecasting_IA"]</span>
                </div>
                <div class="card-body">
                    <!-- Placeholder for chart -->
                    <div class="bg-light rounded-3 p-3" style="height: 260px;">
                        <p class="text-muted">@L["Exec_Forecasting_ChartPlaceholder"]</p>
                        <!-- Integrate chart library later (e.g., Chart.js, ApexCharts) -->
                    </div>
                    <div class="mt-3 d-flex flex-wrap gap-3">
                        <div>
                            <span class="text-muted">@L["Exec_Forecasting_Next30Days"]</span>
                            <h6 class="fw-bold">@ForecastNext30Days.ToString("N0")</h6>
                        </div>
                        <div>
                            <span class="text-muted">@L["Exec_Forecasting_RiskScore"]</span>
                            <h6 class="fw-bold">@RiskScore.ToString("N1") / 10</h6>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Province ranking -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@L["Exec_ProvinceRanking_Title"]</h5>
                    <span class="badge bg-secondary">@L["Exec_ProvinceRanking_Label"]</span>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        @foreach (var item in ProvinceRanking)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>@item.Province</span>
                                <span class="fw-bold">@item.IncidentCount.ToString("N0")</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom row: Profitability dashboard + category breakdown -->
    <div class="row g-3">
        <!-- Profitability (coûts vs revenus) -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@L["Exec_Profitability_Title"]</h5>
                    <span class="badge bg-success">@L["Exec_Profitability_Label"]</span>
                </div>
                <div class="card-body">
                    <div class="bg-light rounded-3 p-3 mb-3" style="height: 220px;">
                        <p class="text-muted">@L["Exec_Profitability_ChartPlaceholder"]</p>
                    </div>
                    <div class="row text-center">
                        <div class="col-4">
                            <small class="text-muted">@L["Exec_Profitability_Costs"]</small>
                            <div class="fw-bold">@TotalCosts.ToString("N0") $</div>
                        </div>
                        <div class="col-4">
                            <small class="text-muted">@L["Exec_Profitability_Revenues"]</small>
                            <div class="fw-bold">@TotalRevenues.ToString("N0") $</div>
                        </div>
                        <div class="col-4">
                            <small class="text-muted">@L["Exec_Profitability_Net"]</small>
                            <div class="fw-bold">@NetProfit.ToString("N0") $</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Category breakdown -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@L["Exec_CategoryBreakdown_Title"]</h5>
                    <span class="badge bg-warning text-dark">@L["Exec_CategoryBreakdown_Label"]</span>
                </div>
                <div class="card-body">
                    <div class="bg-light rounded-3 p-3 mb-3" style="height: 220px;">
                        <p class="text-muted">@L["Exec_CategoryBreakdown_ChartPlaceholder"]</p>
                    </div>
                    <ul class="list-group list-group-flush">
                        @foreach (var cat in CategoryBreakdown)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>@cat.CategoryName</span>
                                <span class="fw-bold">@cat.IncidentCount.ToString("N0")</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string SelectedPeriod { get; set; } = "Last30Days";
    private string? SelectedProvince { get; set; }

    private List<string> Provinces { get; } = new()
    {
        "Kinshasa", "Kongo Central", "Nord-Kivu", "Sud-Kivu", "Haut-Katanga"
        // etc.
    };

    // Mock data for now – later bind to API
    private int TotalIncidents { get; set; } = 1245;
    private double IncidentTrend { get; set; } = 8.3;
    private double AmountSaved { get; set; } = 3_500_000;
    private double AverageProcessingDays { get; set; } = 12.4;
    private double ProfitabilityRatio { get; set; } = 0.72;

    private double ForecastNext30Days { get; set; } = 210;
    private double RiskScore { get; set; } = 6.7;

    private double TotalCosts { get; set; } = 850_000;
    private double TotalRevenues { get; set; } = 4_350_000;
    private double NetProfit => TotalRevenues - TotalCosts;

    private List<(string Province, int IncidentCount)> ProvinceRanking { get; } =
        new()
        {
            ("Kinshasa", 420),
            ("Nord-Kivu", 210),
            ("Haut-Katanga", 180),
            ("Kongo Central", 150),
            ("Sud-Kivu", 120)
        };

    private List<(string CategoryName, int IncidentCount)> CategoryBreakdown { get; } =
        new()
        {
            ("Corruption", 380),
            ("Fraude financière", 260),
            ("Conflit d'intérêts", 190),
            ("Blanchiment d'argent", 140),
            ("Cybercriminalité", 80)
        };

    private string GetTrendClass(double trend)
        => trend >= 0 ? "text-success" : "text-danger";
}
