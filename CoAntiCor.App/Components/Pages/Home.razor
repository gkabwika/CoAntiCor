@page "/"
@using CoAntiCor.App.Resources
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L
@using Microsoft.Extensions.Localization
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> Localizer

<div class="container py-4">

    <!-- Top banner -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="p-4 rounded-3 text-white d-flex flex-column flex-md-row align-items-center"
                 style="background: linear-gradient(135deg,#0047AB,#008B8B);">
                <div class="flex-grow-1">
                    <h1 class="fw-bold mb-2">@Localizer["Banner_Title"]</h1>
                    <p class="mb-3">@Localizer["Banner_Subtitle"]</p>
                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-light btn-sm" @onclick="StartWizard">
                            @Localizer["Banner_ReportIncident"]
                        </button>
                        <button class="btn btn-outline-light btn-sm">
                            @Localizer["Banner_ViewStatistics"]
                        </button>
                    </div>
                </div>
                <div class="mt-3 mt-md-0 ms-md-4 text-end">
                    <span class="badge bg-warning text-dark me-2">@Localizer["Banner_AnonymousPossible"]</span>
                    <span class="badge bg-success">@Localizer["Banner_SecurePlatform"]</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Carousel: “products & services” of justice / anti-corruption -->
    <div class="row mb-4">
        <div class="col-lg-8">
            <div id="coanticorCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#coanticorCarousel" data-bs-slide-to="0" class="active"></button>
                    <button type="button" data-bs-target="#coanticorCarousel" data-bs-slide-to="1"></button>
                    <button type="button" data-bs-target="#coanticorCarousel" data-bs-slide-to="2"></button>
                </div>
                <div class="carousel-inner rounded-3 shadow-sm">
                    <div class="carousel-item active">
                        <div class="d-flex flex-column flex-md-row p-4 bg-light">
                            <div class="flex-grow-1">
                                <h3>@Localizer["Carousel_OnlineReporting_Title"]</h3>
                                <p>@Localizer["Carousel_OnlineReporting_Description"]</p>
                                <button class="btn btn-primary btn-sm" @onclick="StartWizard">
                                    @Localizer["Carousel_OnlineReporting_Action"]
                                </button>
                            </div>
                            <div class="ms-md-4 mt-3 mt-md-0 text-muted small">
                                <ul class="list-unstyled">
                                    <li>• @Localizer["Carousel_OnlineReporting_Point1"]</li>
                                    <li>• @Localizer["Carousel_OnlineReporting_Point2"]</li>
                                    <li>• @Localizer["Carousel_OnlineReporting_Point3"]</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="carousel-item">
                        <div class="d-flex flex-column flex-md-row p-4 bg-light">
                            <div class="flex-grow-1">
                                <h3>@Localizer["Carousel_Analytics_Title"]</h3>
                                <p>@Localizer["Carousel_Analytics_Description"]</p>
                                <button class="btn btn-outline-primary btn-sm">
                                    @Localizer["Carousel_Analytics_Action"]
                                </button>
                            </div>
                            <div class="ms-md-4 mt-3 mt-md-0 text-muted small">
                                <ul class="list-unstyled">
                                    <li>• @Localizer["Carousel_Analytics_Point1"]</li>
                                    <li>• @Localizer["Carousel_Analytics_Point2"]</li>
                                    <li>• @Localizer["Carousel_Analytics_Point3"]</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="carousel-item">
                        <div class="d-flex flex-column flex-md-row p-4 bg-light">
                            <div class="flex-grow-1">
                                <h3>@Localizer["Carousel_PublicReports_Title"]</h3>
                                <p>@Localizer["Carousel_PublicReports_Description"]</p>
                                <button class="btn btn-outline-secondary btn-sm">
                                    @Localizer["Carousel_PublicReports_Action"]
                                </button>
                            </div>
                            <div class="ms-md-4 mt-3 mt-md-0 text-muted small">
                                <ul class="list-unstyled">
                                    <li>• @Localizer["Carousel_PublicReports_Point1"]</li>
                                    <li>• @Localizer["Carousel_PublicReports_Point2"]</li>
                                    <li>• @Localizer["Carousel_PublicReports_Point3"]</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <button class="carousel-control-prev" type="button" data-bs-target="#coanticorCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#coanticorCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>
        </div>

        <!-- Right column: quick access cards -->
        <div class="col-lg-4 mt-4 mt-lg-0">
            <div class="card mb-3 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@Localizer["Card_Anonymous_Title"]</h5>
                    <p class="card-text">@Localizer["Card_Anonymous_Description"]</p>
                    <button class="btn btn-outline-danger btn-sm" @onclick="StartWizard">
                        @Localizer["Card_Anonymous_Action"]
                    </button>
                </div>
            </div>
            <div class="card mb-3 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@Localizer["Card_Login_Title"]</h5>
                    <p class="card-text">@Localizer["Card_Login_Description"]</p>
                    <a class="btn btn-outline-primary btn-sm" href="/login">
                        @Localizer["Card_Login_Action"]
                    </a>
                </div>
            </div>
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@Localizer["Card_Executive_Title"]</h5>
                    <p class="card-text">@Localizer["Card_Executive_Description"]</p>
                    <a class="btn btn-outline-success btn-sm" href="/executive-dashboard">
                        @Localizer["Card_Executive_Action"]
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab menu: “products” = main features -->
    <div class="row mb-4">
        <div class="col-12">
            <ul class="nav nav-tabs" id="featureTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="report-tab" data-bs-toggle="tab"
                            data-bs-target="#report" type="button" role="tab">
                        @Localizer["Tab_ReportIncident"]
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="track-tab" data-bs-toggle="tab"
                            data-bs-target="#track" type="button" role="tab">
                        @Localizer["Tab_TrackCases"]
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="bi-tab" data-bs-toggle="tab"
                            data-bs-target="#bi" type="button" role="tab">
                        @Localizer["Tab_ExecutiveBI"]
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="store-tab" data-bs-toggle="tab"
                            data-bs-target="#store" type="button" role="tab">
                        @Localizer["Tab_PublicStore"]
                    </button>
                </li>
            </ul>

            <div class="tab-content border border-top-0 p-3 bg-white shadow-sm">
                <div class="tab-pane fade show active" id="report" role="tabpanel">
                    <h5>@Localizer["Tab_ReportIncident_Title"]</h5>
                    <p>@Localizer["Tab_ReportIncident_Text"]</p>
                    <button class="btn btn-primary btn-sm" @onclick="StartWizard">
                        @Localizer["Tab_ReportIncident_Start"]
                    </button>
                </div>
                <div class="tab-pane fade" id="track" role="tabpanel">
                    <h5>@Localizer["Tab_TrackCases_Title"]</h5>
                    <p>@Localizer["Tab_TrackCases_Text"]</p>
                </div>
                <div class="tab-pane fade" id="bi" role="tabpanel">
                    <h5>@Localizer["Tab_ExecutiveBI_Title"]</h5>
                    <p>@Localizer["Tab_ExecutiveBI_Text"]</p>
                </div>
                <div class="tab-pane fade" id="store" role="tabpanel">
                    <h5>@Localizer["Tab_PublicStore_Title"]</h5>
                    <p>@Localizer["Tab_PublicStore_Text"]</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Culture switcher -->
  @*   <div class="row">
        <div class="col-12 text-end">
            <button class="btn btn-link btn-sm" @onclick="() => ChangeCulture("fr-CD")">FR</button>
            <button class="btn btn-link btn-sm" @onclick="() => ChangeCulture("en-US")">EN</button>
        </div>
    </div> *@
</div>

@code {
    private void StartWizard()
    {
        NavigationManager.NavigateTo("/wizard/incident");
    }

    [Inject] NavigationManager NavigationManager { get; set; } = default!;

    private void ChangeCulture(string culture)
    {
        // You can implement culture change via querystring or cookie
        var uri = new Uri(NavigationManager.Uri);
        var baseUri = uri.GetLeftPart(UriPartial.Path);
        NavigationManager.NavigateTo($"{baseUri}?culture={culture}", forceLoad: true);
    }
}
