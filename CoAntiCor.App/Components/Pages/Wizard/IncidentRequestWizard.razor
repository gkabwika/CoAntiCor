@page "/wizard/{DraftId:guid}"
@page "/wizard/"
@using FluentValidation

@inject IValidator<WizardDraftState> Validator
@using CoAntiCor.App.Resources
@using CoAntiCor.Core.DTO.Incident
@using CoAntiCor.Core.Domain.ServiceRequest
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@inject HttpClient Http
@inject NavigationManager Nav

<h2 class="fw-bold mb-3">@Localizer["Wizard_Title"]</h2>

<div class="wizard-header mb-3">
    <p>@string.Format(Localizer["Wizard_Main_StepIndicator"], Draft.CurrentStep, TotalSteps)</p>
</div>

<div class="alert alert-info d-flex align-items-center" role="alert">
    <span class="me-2">
        @Localizer["Wizard_Autosave_Status"]:
        @if (IsSaving)
        {
            <span class="text-warning">@Localizer["Wizard_Autosave_Saving"]…</span>
        }
        else if (LastSavedUtc.HasValue)
        {
            <span class="text-success">@Localizer["Wizard_Autosave_LastSaved"] @LastSavedUtc.Value.ToLocalTime()</span>
        }
        else
        {
            <span class="text-muted">@Localizer["Wizard_Autosave_NotSaved"]</span>
        }
    </span>
</div>
@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger">@ErrorMessage</div>
}
@if (ValidationErrors.Any())
{
    <div id="ToValidationsummary" class="company-type-details alert alert-heading">
        @* <div class="alert alert-danger"> *@
        <span class="text-danger"> <i class="fas fa-exclamation-circle"></i></span>  <span class="text-black"> @Localizer["ErrorSummary"] (@Localizer["Step"] @Draft.CurrentStep)</span>
        <ul class="validation-errors">
            @foreach (var err in ValidationErrors)
            {
                <li>
                    @err.Message
                    <a href="javascript:void(0)" @onclick="() => ScrollToAndHighlight(err.ElementId)">
                        @Localizer["Fix"]
                    </a>
                </li>
            }
        </ul>

    </div>
}
<!-- TOP NAVIGATION -->
<ul class="nav nav-pills mb-3">
    @for (int step = 1; step <= TotalSteps; step++)
    {
        var active = step == Draft.CurrentStep ? "active" : "";
        <li class="nav-item">
            <button class="nav-link @active" @onclick="() => GoToStep(step)">
                @Localizer[$"Wizard_Step_{step}"]
            </button>
        </li>
    }
</ul>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <WizardRouter Draft="Draft"
                      OnSave="SaveDraftAsync"
                      OnNext="NextStep"
                      OnPrevious="PreviousStep"
                      OnSubmit="SubmitAsync" />
    </div>
     

</div>

@code {
    [Parameter] public Guid? DraftId { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback? OnPrevious { get; set; }  // optional

    private WizardDraftState Draft { get; set; } = new() { CurrentStep = 1 };
    private bool IsSaving { get; set; }
    private DateTime? LastSavedUtc { get; set; }
    [Inject] IJSRuntime? JS { get; set; }
    bool IsBusy;
    string TransitionClass = "";
    protected string? ErrorMessage = null;
    private List<(string Message, string ElementId)> ValidationErrors = new();
    [Parameter] public Guid IncidentRequestId { get; set; }
    private IncidentDetail Detail { get; set; } = new IncidentDetail();
    public int TotalSteps { get; set; } = 7;

    protected override async Task OnInitializedAsync()
    {
        // 1. Stabilize DraftId
        if (DraftId == null || DraftId == Guid.Empty)
        {
            DraftId = Guid.NewGuid();
        }

        Draft.DraftId = DraftId.Value;
        try
        {
            // Load only once
            var result = await Http.GetFromJsonAsync<WizardDraftState>($"api/v1/wizard/{Draft.DraftId}");
            Draft = result ?? new WizardDraftState
            {
                DraftId = Draft.DraftId,
                CurrentStep = 1,
                Version = 0,
                IsAnonymous = true
            };
        }
        catch
        {
            // New draft
            Draft = new WizardDraftState
            {
                DraftId = Draft.DraftId,
                CurrentStep = 1,
                Version = 0,
                IsAnonymous = true
            };
        }
    }

    private async Task LoadDraftAsync()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<WizardDraftState>($"api/v1/wizard/{Draft.DraftId}");
            if (result != null)
            {
                Draft = result;
                LastSavedUtc = DateTime.UtcNow;
            }
        }
        catch
        {
            // New draft
            Draft = new WizardDraftState
            {
                DraftId = Draft.DraftId,
                CurrentStep = 1,
                Version = 0,
                IsAnonymous = true
            };
        }
    }

    private async Task SaveDraftAsync()
    {
        IsSaving = true;

        var response = await Http.PostAsJsonAsync("api/v1/wizard/save", Draft);

        if (response.IsSuccessStatusCode)
        {
            LastSavedUtc = DateTime.UtcNow;
        }

        IsSaving = false;
    }


    private async Task SaveDraftAsyncNew()
    {
        IsSaving = true;

        //var request = new SaveDraftRequest { Draft = Draft };
        var response = await Http.PostAsJsonAsync("api/v1/wizard/save", Draft);
        var result = await response.Content.ReadFromJsonAsync<SaveDraftResponse>();

        if (result != null && result.Draft != null && response.IsSuccessStatusCode)
        {
            if (result.IsConflict && result.ServerVersion != null)
            {
                // Simple strategy: take server version, but you could show a merge dialog
                Draft = result.ServerVersion;
            }
            else
            {
                Draft = result.Draft;
            }

            LastSavedUtc = DateTime.UtcNow;
        }

        IsSaving = false;
        //StateHasChanged();
    }

    private async Task NextStep()
    {
        ErrorMessage = null;
        IsBusy = true;

        if (!await ValidateCurrentStepAsync())
        {
            IsBusy = false;
            return;
        }

        if (Draft.CurrentStep == 1)
        {
            //1. Setup group of company type
            // SetMyEntrepriseGroupType();
            // Draft.NaturalPersonRequerant ??= new Person();
            // Draft.NaturalPersonRequerant.CurrentAddress ??= new Core.Domain.Address.Address();
            // Draft.NaturalPersonRequerant.NationalityCountry ??= new Core.Domain.Address.Country();
            // Draft.NaturalPersonRequerant.BirthCountry ??= new Core.Domain.Address.Country();
            // Draft.Person!.BirthCountry ??= new Core.Domain.Address.Country();
            // Draft.NaturalPerson!.BirthCountry ??= new Core.Domain.Address.Country();
        }
        if (Draft.CurrentStep == 2)
        {



        }

        if (Draft.CurrentStep < TotalSteps)
        {
            //  TriggerTransition("forward");
            // Wait for animation to settle before saving
         //   await Task.Delay(250);
            Draft.CurrentStep++;
            await SaveDraftAsync();
            StateHasChanged();
            // IsBusy = false;
            // return;
        }

    }
    async Task<bool> ValidateCurrentStepAsync()
    {
        var ruleset = Draft.CurrentStep switch
        {
            1 => "Step1",
            2 => "Step2",
            3 => "Step3",
            4 => "Step4",
            5 => "Step5",
            6 => "Step6",
            _ => null
        };

        // if (ruleset == null) return true;

        // var result = await Validator.ValidateAsync(Draft, opts => opts.IncludeRuleSets(ruleset));
        // // You can surface errors via a ValidationSummary or custom UI
        // if(!result.IsValid)
        // {
        //     // ErrorMessage = string.Join("; ", result.Errors.Select(e => e.ErrorMessage));
        //     ErrorMessage = string.Join("<br/>", result.Errors.Select(e => e.ErrorMessage));
        // }


        ValidationErrors.Clear();

        var result = await Validator.ValidateAsync(Draft, opts => opts.IncludeRuleSets(ruleset));

        if (!result.IsValid)
        {
            ValidationErrors = result.Errors
                .Select(e => (e.ErrorMessage, e.CustomState?.ToString() ?? ""))
                .ToList();

            return false;
        }
        return result.IsValid;
    }
    private async Task PreviousStep()
    {
        if (Draft.CurrentStep > 1)
        {
            Draft.CurrentStep--;
            await SaveDraftAsync();
        }
    }

    private async Task GoToStepOld(int step)
    {
        Draft.CurrentStep = step;
        await SaveDraftAsync();
    }
    private async Task GoToStep(int step)
    {
        // DO NOT reload draft here
        // DO NOT regenerate DraftId

        Draft.CurrentStep = step;

        // Save AFTER updating the step
        await SaveDraftAsync();

        // Force UI refresh without reloading draft
        StateHasChanged();
    }


    private async Task SubmitAsync()
    {
        var response = await Http.PostAsJsonAsync("api/v1/wizard/submit", Draft);
        if (response.IsSuccessStatusCode)
        {
            // You can navigate to confirmation page or show toast
            Nav.NavigateTo("/wizard/submitted");
        }
    }
    private Task OnValidSubmit()
    {
        // Persist Detail to DB (IncidentDetail linked to IncidentRequestId)
        return Task.CompletedTask;
    }

    async Task ScrollToAndHighlight(string id)
    {
        await JS!.InvokeVoidAsync("scrollToAndHighlight", id);
    }

    //my current animation code
    //Only the UI thread (the Blazor dispatcher) may trigger rendering.
    void TriggerTransition(string direction)
    {
        TransitionClass = direction == "forward" ? "wizard-forward" : "wizard-back";

        _ = Task.Run(async () =>
        {
            await Task.Delay(300);
            TransitionClass = "";

            await InvokeAsync(StateHasChanged); // ✔ safe UI update
        });
    }
    private void Login()
    {
        Nav.NavigateTo($"/account/login?returnUrl={Uri.EscapeDataString(Nav.Uri)}");
    }
}




