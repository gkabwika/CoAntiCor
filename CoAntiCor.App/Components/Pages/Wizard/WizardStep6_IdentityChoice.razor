@using CoAntiCor.Core.DTO
@using CoAntiCor.Core.DTO.Incident
@using CoAntiCor.Core.Domain
@using CoAntiCor.App.Resources
@using CoAntiCor.Core.Domain.ServiceRequest
@using Microsoft.Extensions.Localization

@using CoAntiCor.Core.DTO
@using System.Timers
@inject HttpClient Http

@inject IStringLocalizer<SharedResource> Localizer

<div class="card p-3">
    <h4>@Localizer["Wizard_Step6_Title"]</h4>


    <div>

        <EditForm Model="@Detail" OnValidSubmit="OnValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <h3>@Localizer["IncidentDetail_Title"]</h3>
            <p>Vous pouvez continuer en mode anonyme, créer un compte fictif ou utiliser un compte réel.</p>

            <fieldset class="row sec-group col-md-12 col-sm-12">

                <legend class="text-black-50">@Localizer["IncidentDetail_Title"]</legend>
                <h3>@Localizer["IncidentDetail_Title"]</h3>
                <div class="row g-3">
                    <div class="col-md-12 col-sm-12">
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-6 col-sm-6">
                    </div>
                    <div class="col-md-6 col-sm-6">
                    </div>
                </div>
            </fieldset>


            <div class="list-group mb-3">
                <button class="list-group-item" @onclick="ChooseAnonymous">
                    @Localizer["Identity_ContinueAnonymous"]
                </button>
                <button class="list-group-item" @onclick="ChooseFake">
                    @Localizer["Identity_FakeAccount"]
                </button>
                <button class="list-group-item" @onclick="ChooseReal">
                    @Localizer["Identity_RealAccount"]
                </button>
            </div>

            @if (Draft.IdentityChoice == "fake")
            {
                <input class="form-control mb-2" placeholder="Nom d’utilisateur fictif" />
                <!-- hook to a fake account API if needed -->
            }

            @if (Draft.IdentityChoice == "real")
            {
                <p>Redirection vers la page de connexion…</p>
                <!-- you can trigger navigation to /login -->
            }

            <button class="btn btn-primary" @onclick="() => OnSave.InvokeAsync()">
                @Localizer["SearchSimilarCases_SaveButton"]
            </button>

            <button type="submit" class="btn btn-primary">@Localizer["Wizard_Submit"]</button>
        </EditForm>

    </div>

    <!-- Navigation buttons -->
    <div class="mt-3 d-flex justify-content-between">
        <button class="btn btn-outline-secondary" disabled>
            @Localizer["Wizard_Previous"]
        </button>

        <div class="d-flex gap-2">
            <button class="btn btn-secondary" @onclick="() => OnSave.InvokeAsync()">
                @Localizer["Wizard_SaveDraft"]
            </button>

            <button class="btn btn-primary" @onclick="() => OnNext.InvokeAsync()">
                @Localizer["Wizard_Next"]
            </button>
        </div>
    </div>
</div>


@code {
    [Parameter] public WizardDraftState Draft { get; set; } = default!;
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnPrevious { get; set; }


    [Parameter] public EventCallback<string> OnSelectIdentity { get; set; }
    private void ChooseAnonymous() => Choose("anonymous");
    private void ChooseFake() => Choose("fake");
    private void ChooseReal() => Choose("real");

    void Choose(string choice) => Draft.IdentityChoice = choice;

    private IncidentDetail Detail { get; set; } = new IncidentDetail();
    private Task OnValidSubmit()
    {
        // Persist Detail to DB (IncidentDetail linked to IncidentRequestId)
        return Task.CompletedTask;
    }
}

