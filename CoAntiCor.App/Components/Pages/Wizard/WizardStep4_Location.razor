@using CoAntiCor.Core.DTO
@using CoAntiCor.Core.DTO.Incident
@using CoAntiCor.Core.Domain
@using CoAntiCor.App.Resources
@using CoAntiCor.Core.Domain.ServiceRequest
@using Microsoft.Extensions.Localization

@using CoAntiCor.Core.DTO
@using System.Timers
@inject HttpClient Http

@inject IStringLocalizer<SharedResource> Localizer


<div class="card p-3">
    <h4>@Localizer["Wizard_Step4_Title"]</h4>

    <div>


        <EditForm Model="@Detail" OnValidSubmit="OnValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <h3>@Localizer["IncidentDetail_Title"]</h3>


            <fieldset class="row sec-group col-md-12 col-sm-12">

                <legend class="text-black-50">@Localizer["IncidentDetail_Title"]</legend>
                <h3>@Localizer["IncidentDetail_Title"]</h3>
                <div class="row g-3">
                    <div class="col-md-12 col-sm-12">
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-6 col-sm-6">
                    </div>
                    <div class="col-md-6 col-sm-6">
                    </div>
                </div>
            </fieldset>


            <select class="form-select mb-2" @bind="Draft.Province">
                <option value="">@Localizer["Wizard_SelectOption"]</option>
                @foreach (var p in Offices.Select(o => o.Province).Distinct())
                {
                    <option value="@p">@p</option>
                }
            </select>

            <input class="form-control mb-2" @bind="Draft.City" placeholder="Ville" />
            <input class="form-control mb-2" @bind="Draft.Commune" placeholder="Commune" />
            <input class="form-control mb-2" @bind="Draft.Quartier" placeholder="Quartier" />
            <input class="form-control mb-2" @bind="Draft.Address" placeholder="Adresse précise" />

            <select class="form-select mb-2" @bind="Draft.GovernmentOfficeId">
                <option value="">@Localizer["Wizard_SelectOption"]</option>
                @foreach (var o in Offices.Where(o => Draft.Province == null || o.Province == Draft.Province))
                {
                    <option value="@o.Id">@o.Name</option>
                }
            </select>

            @*     <select class="form-select mb-2" @bind="Draft.GovernmentOfficeId">
        <option value="">Bureau / Tribunal</option>
        @foreach (var o in FilteredOffices)
        {
            <option value="@o.Id">@o.Name (@o.City)</option>
        }
    </select> *@

            <button class="btn btn-primary" @onclick="() => OnSave.InvokeAsync()">
                @Localizer["SearchSimilarCases_SaveButton"]
            </button>

            <button type="submit" class="btn btn-primary">@Localizer["Wizard_Submit"]</button>
        </EditForm>


    </div>


    <!-- Navigation buttons -->
    <div class="mt-3 d-flex justify-content-between">
        <button class="btn btn-outline-secondary" disabled>
            @Localizer["Wizard_Previous"]
        </button>

        <div class="d-flex gap-2">
            <button class="btn btn-secondary" @onclick="() => OnSave.InvokeAsync()">
                @Localizer["Wizard_SaveDraft"]
            </button>

            <button class="btn btn-primary" @onclick="() => OnNext.InvokeAsync()">
                @Localizer["Wizard_Next"]
            </button>
        </div>
    </div>


    
</div>
@code {
    [Parameter] public WizardDraftState Draft { get; set; } = default!;
    [Parameter] public IEnumerable<ProvinceDto> Provinces { get; set; } = Enumerable.Empty<ProvinceDto>();
    [Parameter] public IEnumerable<GovernmentOfficeDto> Offices { get; set; } = Enumerable.Empty<GovernmentOfficeDto>();
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnPrevious { get; set; }


    IEnumerable<GovernmentOfficeDto> FilteredOffices =>
        Offices.Where(o => o.Name == Draft.Province);

    private IncidentDetail Detail { get; set; } = new IncidentDetail();
    private Task OnValidSubmit()
    {
        // Persist Detail to DB (IncidentDetail linked to IncidentRequestId)
        return Task.CompletedTask;
    }
}