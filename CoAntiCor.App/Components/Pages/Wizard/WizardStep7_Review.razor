@using CoAntiCor.Core.DTO
@using CoAntiCor.Core.DTO.Incident
@using CoAntiCor.Core.Domain
@using CoAntiCor.App.Resources
@using CoAntiCor.Core.Domain.ServiceRequest
@using Microsoft.Extensions.Localization
@using System.Text.Json

@using System.Timers
@inject HttpClient Http

@inject IStringLocalizer<SharedResource> Localizer


<div class="card p-3">
    <h4>@Localizer["Wizard_Step7_Title"]</h4>

    <div>

        <EditForm Model="@Detail" OnValidSubmit="OnValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <h3>@Localizer["Wizard_Step7_ReviewInformation"]</h3>


            <fieldset class="row sec-group col-md-12 col-sm-12">

                <legend class="text-black-50">@Localizer["IncidentDetail_Title"]</legend>
                <h3>@Localizer["IncidentDetail_Title"]</h3>
                <div class="row g-3">
                    <div class="col-md-12 col-sm-12">
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-6 col-sm-6">
                    </div>
                    <div class="col-md-6 col-sm-6">
                    </div>
                </div>
            </fieldset>


            <pre class="bg-light p-3 border">
                @GetDraftJson()
            </pre>

            <dl class="row">
                <dt class="col-sm-3">Titre</dt>
                <dd class="col-sm-9">@Draft.Title</dd>
                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Draft.Description</dd>
                <dt class="col-sm-3">Province</dt>
                <dd class="col-sm-9">@Draft.Province</dd>
                <dt class="col-sm-3">Anonyme</dt>
                <dd class="col-sm-9">@Draft.IsAnonymous</dd>
                <dt class="col-sm-3">Choix identité</dt>
                <dd class="col-sm-9">@Draft.IdentityChoice</dd>
            </dl>

            <button class="btn btn-primary" @onclick="() => OnSubmit.InvokeAsync()">
                @Localizer["SearchSimilarCases_SaveButton"]
            </button>

            <button type="submit" class="btn btn-primary">@Localizer["Wizard_Submit"]</button>
        </EditForm>

    </div>

</div>

@code {
    [Parameter] public WizardDraftState Draft { get; set; } = default!;
    [Parameter] public EventCallback OnSubmit { get; set; }

    private string GetDraftJson() => JsonSerializer.Serialize(Draft, new JsonSerializerOptions { WriteIndented = true });

    private IncidentDetail Detail { get; set; } = new IncidentDetail();
    private Task OnValidSubmit()
    {
        // Persist Detail to DB (IncidentDetail linked to IncidentRequestId)
        return Task.CompletedTask;
    }
}
