@using CoAntiCor.Core.DTO
@using CoAntiCor.Core.DTO.Incident
@using CoAntiCor.Core.Domain
@using CoAntiCor.App.Resources
@using CoAntiCor.Core.Domain.ServiceRequest
@using Microsoft.Extensions.Localization

@using CoAntiCor.Core.DTO
@using System.Timers
@inject HttpClient Http

@inject IStringLocalizer<SharedResource> Localizer

<div class="card p-3">
    <h4>@Localizer["Wizard_Step5_Title"]</h4>


    <div>

        <EditForm Model="@Detail" OnValidSubmit="OnValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <h3>@Localizer["IncidentDetail_Title"]</h3>


            <fieldset class="row sec-group col-md-12 col-sm-12">

                <legend class="text-black-50">@Localizer["IncidentDetail_Title"]</legend>
                <h3>@Localizer["IncidentDetail_Title"]</h3>
                <div class="row g-3">
                    <div class="col-md-12 col-sm-12">
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-6 col-sm-6">
                    </div>
                    <div class="col-md-6 col-sm-6">
                    </div>
                </div>
            </fieldset>


                <input class="form-control mb-2" @bind="Draft.Title" placeholder="Titre de l’incident" />
                <textarea class="form-control mb-2" rows="5" @bind="Draft.Description" placeholder="Description détaillée"></textarea>

                <InputFile OnChange="OnInputFileChange" multiple />

                <ul class="mt-2">
                    @foreach (var a in Draft.Attachments)
                    {
                        <li>@a.FileName</li>
                    }
                </ul>


                below new version


        <h4>@Localizer["Wizard_Step5_Title"]</h4>

        <button class="btn btn-secondary mb-2" @onclick="() => OnUpload.InvokeAsync()">
            @Localizer["Wizard_Step5_UploadAttachment"]
        </button>

        @foreach (var a in Draft.Attachments)
        {
            <div class="border p-2 mb-2">
                <strong>@a.FileName</strong>
                <button class="btn btn-danger btn-sm float-end"
                        @onclick="() => OnRemove.InvokeAsync(a.Id)">
                    @Localizer["Wizard_Step5_RemoveAttachment"]
                </button>
            </div>
        }


            <button class="btn btn-primary" @onclick="() => OnSave.InvokeAsync()">
                @Localizer["SearchSimilarCases_SaveButton"]
            </button>

            <button type="submit" class="btn btn-primary">@Localizer["Wizard_Submit"]</button>
        </EditForm>

    </div>


</div>


@code {
    [Parameter] public WizardDraftState Draft { get; set; } = default!;
    [Parameter] public EventCallback OnUpload { get; set; }
    [Parameter] public EventCallback<Guid> OnRemove { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }

    private IncidentDetail Detail { get; set; } = new IncidentDetail();
    private Task OnValidSubmit()
    {
        // Persist Detail to DB (IncidentDetail linked to IncidentRequestId)
        return Task.CompletedTask;
    }

    async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(10))
        {
            // call api/evidence/upload, get temp id/path
            Draft.Attachments.Add(new AttachmentDraftItem
            {
                Id = Guid.NewGuid(),
                FileName = file.Name,
                StoragePath = $"temp/{file.Name}"
            });
        }
        await OnSave.InvokeAsync();
    }
}
