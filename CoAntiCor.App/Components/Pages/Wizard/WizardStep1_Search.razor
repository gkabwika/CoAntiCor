@using CoAntiCor.App.Resources
@using CoAntiCor.Core.DTO
@using CoAntiCor.Core.DTO.Incident
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@inject HttpClient Http

<br />
<PageTitle>@Localizer["ReportAnIncident"] / @Localizer["SearchSimilarCases_Title"]</PageTitle>
<div class="card p-3">
    <h4>@Localizer["Step"] 1: @Localizer["SearchSimilarCases_Title"]</h4>
    <p>
        @Localizer["DescribeyourincidentWewillsearchforsimilarcasesintheCoAntiCorsystem"]
    </p>
    <input class="form-control mb-2" id="stp1-search-something" name="stp1-search-something"
           @bind="Draft.SearchQuery" data-rule-required="true" aria-invalid="false"
           placeholder="@Localizer["SearchSimilarCases_SearchQuery_Placeholder"]" />

    <input class="form-control mb-2"
           @bind="Draft.AccessCode"
           placeholder="@Localizer["SearchSimilarCases_AccessCode_Placeholder"]" />


    @if (_isSearching)
    {
        <button id="stp1-search-id02" class="btn btn-primary mt-2" @onclick="SearchAsync" disabled="@_isSearching">
            @Localizer["Searching"]...
        </button>
    }
    else
    {
        <button id="stp1-search-id03" class="btn btn-primary mt-2" @onclick="SearchAsync" disabled="@_isSearching">
            @Localizer["Search"]
        </button>
    }
    <button class="btn btn-success  mt-2"
            @onclick="() => OnSave.InvokeAsync()">
        @(Localizer != null ? Localizer["Save_Name"] : "Save")
    </button>
    @if (Draft.SimilarIncidents.Any())
    {
        <h5 class="mt-3">Similar incidents found</h5>
        <ul class="list-group">
            @foreach (var incident in Draft.SimilarIncidents)
            {
                <li class="list-group-item">
                    <strong>@incident.ComplaintNumber</strong> - @incident.Title
                    <br />
                    <small>@incident.ShortDescription</small>
                </li>
            }
        </ul>

        <div class="mt-3">
            <p>
                @Localizer["Ifyourcaseisdifferentoryoustillwanttoreportanewincidentcontinue"]
            </p>
        </div>
    }
</div>


@code {
    [Parameter] public WizardDraftState Draft { get; set; } = default!;
    [Parameter] public EventCallback OnSave { get; set; }
    //[Parameter] public WizardDraftState State { get; set; } = default!;
  //  [Parameter] public EventCallback OnNext { get; set; }

    private bool _isSearching;

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(Draft!.SearchQuery))
            return;

        _isSearching = true;

        var response = await Http.PostAsJsonAsync("/api/v1/ServiceRequest/SearchIncident", new
        {
            Term = Draft!.SearchQuery,
            MaxResults = 10
        });

        response.EnsureSuccessStatusCode();

        var results = await response.Content.ReadFromJsonAsync<List<SimilarIncidentDto>>();
        Draft.SimilarIncidents = results ?? new List<SimilarIncidentDto>();

        _isSearching = false;
    }
}

