@using CoAntiCor.App.Components.Account.Shared
@using CoAntiCor.App.Services
@inject AuditedNavigationManager AuditedNav
@using CoAntiCor.API.Services
@using CoAntiCor.App.Components.Account
@using CoAntiCor.App.Components.Layout
@using CoAntiCor.App.Components.Shared
@using Microsoft.AspNetCore.Components.Authorization
@inject JwtAuthenticationStateProvider AuthProvider
@inject IdentityRedirectManager RedirectManager
@inject AuditedNavigationManager AuditedNav
@inject NavigationManager NavigationManager

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            @* Replace RouteView with AuthorizeRouteView *@
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Shared.MainLayout)">
                <NotAuthorized>
                    @* This runs when a user hits an [Authorize] page while logged out *@
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>

        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(Layout.MainLayout)">
                <p>Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthProvider.InitializeAsync(); // sets _initialized = true
        }

    }
    // protected override void OnAfterRender(bool firstRender)
    // {
    //     if (firstRender)
    //     {
    //         RedirectManager.RedirectToCurrentPage();
    //     }
    // }
    // Routes.razor (C#)
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // For interactive rendering, do a normal navigate:
            NavigationManager.NavigateTo(new Uri(NavigationManager.Uri).GetLeftPart(UriPartial.Path));
        }
    }

}